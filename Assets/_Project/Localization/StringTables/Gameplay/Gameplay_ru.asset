  - m_Id: 60000020000000
    m_Localized: "\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0437\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u044C \u043F\u0440\u0435\u0444\u0430\u0431 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0430."
