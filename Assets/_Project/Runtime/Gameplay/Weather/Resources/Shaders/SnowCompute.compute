#pragma kernel CSMain

struct SnowParticle
{
	float3 position;
	float seed;
	float3 velocity;
	float size;
};

RWStructuredBuffer<SnowParticle> _SnowParticles;

float3 _VolumeCenter;
float3 _VolumeHalfExtents;
float3 _Wind;
float _DeltaTime;
uint _ParticleCount;
float _Time;
float _SeedOffset;
float _MinSize;
float _MaxSize;
float _FallSpeedMin;
float _FallSpeedMax;
float _SwayAmplitude;
float _SwayFrequency;

float Hash(float s)
{
	return frac(sin(s) * 43758.5453);
}

float WrapEdge()
{
	return 0.5;
}

float SnowflakeSizeT(float seed)
{
	float sizeT = pow(Hash(seed + 0.7), 1.35);
	float largeFlake = step(0.92, Hash(seed + 1.17));
	float tinyFlake = 1.0 - step(0.18, Hash(seed + 1.53));

	sizeT = lerp(sizeT, lerp(sizeT, 1.0, 0.65), largeFlake);
	sizeT = lerp(sizeT, sizeT * 0.35, tinyFlake);
	return saturate(sizeT);
}

// The Long Dark style: every flake falls at its own constant terminal speed and
// sways gently on a per-flake sinusoid. Velocity is derived, never integrated,
// so flakes can never accelerate or spiral out of control.
void RespawnAtTop(inout SnowParticle p, float seed)
{
	float3 he = _VolumeHalfExtents;
	float3 ct = _VolumeCenter;

	p.position = ct + float3(
		(Hash(seed) - 0.5) * he.x * 2.0,
		he.y - Hash(seed + 0.13) * min(4.0, he.y * 0.25),
		(Hash(seed + 0.27) - 0.5) * he.z * 2.0
	);

	float sizeT = SnowflakeSizeT(seed + 3.1);
	p.size = lerp(_MinSize, _MaxSize, sizeT);
	p.seed = seed + _SeedOffset;
}

[numthreads(64, 1, 1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
	uint index = id.x;
	if (index >= _ParticleCount)
	{
		return;
	}

	SnowParticle p = _SnowParticles[index];

	float fallSpeed = lerp(_FallSpeedMin, _FallSpeedMax, Hash(p.seed + 2.2));

	float phase = p.seed * 0.37 + _Time * _SwayFrequency;
	float swayX = sin(phase) * _SwayAmplitude;
	float swayZ = sin(phase * 0.83 + 1.7) * _SwayAmplitude * 0.8;

	float3 velocity = float3(swayX, -fallSpeed, swayZ) + _Wind;
	p.velocity = velocity;
	p.position += velocity * _DeltaTime;

	// Wrap horizontally so wind streams stay dense instead of thinning out.
	float3 rel = p.position - _VolumeCenter;
	float edgeX = _VolumeHalfExtents.x - WrapEdge();
	float edgeZ = _VolumeHalfExtents.z - WrapEdge();

	if (rel.x > edgeX) p.position.x -= edgeX * 2.0;
	else if (rel.x < -edgeX) p.position.x += edgeX * 2.0;

	if (rel.z > edgeZ) p.position.z -= edgeZ * 2.0;
	else if (rel.z < -edgeZ) p.position.z += edgeZ * 2.0;

	// Fallen below the volume: re-emerge near the top.
	if (p.position.y - _VolumeCenter.y < -_VolumeHalfExtents.y)
	{
		float seed = p.seed + _Time * 73.7 + index * 0.137 + _SeedOffset;
		RespawnAtTop(p, seed);
	}

	_SnowParticles[index] = p;
}
