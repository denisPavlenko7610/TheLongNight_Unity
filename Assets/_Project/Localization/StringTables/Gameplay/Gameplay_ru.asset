    m_Localized: "\u0421\u0441\u044B\u043B\u043A\u0430 \u043D\u0430 \u043F\u0440\u0435\u0444\u0430\u0431 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0430 \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u0435\u0442."
