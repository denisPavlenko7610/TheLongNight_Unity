    m_Localized: "\u0421\u0435\u0440\u0432\u0456\u0441 \u0456\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044F \u0432\u0456\u0434\u0441\u0443\u0442\u043D\u0456\u0439."
