    m_Localized: "\u041F\u0440\u0435\u0444\u0430\u0431 \u0431\u0443\u0434\u0456\u0432\u043D\u0438\u0446\u0442\u0432\u0430 \u0432\u0456\u0434\u0441\u0443\u0442\u043D\u0456\u0439."
