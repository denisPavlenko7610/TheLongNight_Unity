    m_Localized: "\u0422\u0443\u0442 \u043D\u0435 \u043C\u043E\u0436\u043D\u0430 \u0440\u043E\u0437\u043C\u0456\u0441\u0442\u0438\u0442\u0438 \u043F\u0440\u0435\u0434\u043C\u0435\u0442."
