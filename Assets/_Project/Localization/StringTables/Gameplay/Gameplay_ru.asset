      m_Items: []
  - m_Id: 60000018000000
    m_Localized: "\u0421\u0435\u0440\u0432\u0438\u0441 Addressables \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u0435\u0442."
