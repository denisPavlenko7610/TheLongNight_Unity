    m_Localized: "\u0421\u0435\u0440\u0432\u0438\u0441 \u044D\u043A\u0438\u043F\u0438\u0440\u043E\u0432\u043A\u0438 \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u0435\u0442."
